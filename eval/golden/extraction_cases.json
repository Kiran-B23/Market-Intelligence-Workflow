  {"name": "an academic citation is NOT a dependency",
   "records": [{"body_text": "See <a href=\"https://stanford.edu/~jurafsky/slp3/\">the textbook</a>.", "evidence_source": "markdown", "object_type": "LEARNING_RESOURCE"}],
