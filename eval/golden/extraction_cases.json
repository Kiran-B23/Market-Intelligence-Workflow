  {"name": "imports in reference solution code become package dependencies",
   "records": [{"body_text": "import gradio as gr\nfrom langchain_chroma import Chroma\nimport os, json", "evidence_source": "solution_code", "object_type": "CODING_QUESTIONS"}],
   "expect": {"must_contain": [{"kind": "package", "canonical_name": "gradio"}, {"kind": "package", "canonical_name": "langchain-chroma"}],
              "must_not_contain": ["os", "json"]}},

  {"name": "pip install inside prose does not yield the sentence as packages",
   "records": [{"body_text": "Later you can pip install the application yourself before the session starts.", "evidence_source": "markdown", "object_type": "LEARNING_RESOURCE"}],
   "expect": {"must_not_contain": ["application", "yourself", "the"]}},

  {"name": "a fenced pip install does yield its packages",
   "records": [{"body_text": "```\n!pip install -qU gradio langchain-community\n```", "evidence_source": "markdown", "object_type": "LEARNING_RESOURCE"}],
   "expect": {"must_contain": [{"kind": "package", "canonical_name": "gradio"}, {"kind": "package", "canonical_name": "langchain-community"}]}},

  {"name": "n8n workflow nodes are captured with their taught typeVersion",
   "records": [{"body_text": "{\"nodes\":[{\"type\":\"@n8n/n8n-nodes-langchain.agent\",\"typeVersion\":2.2},{\"type\":\"n8n-nodes-base.gmail\",\"typeVersion\":2.1}]}", "evidence_source": "solution_code", "object_type": "OBJECTIVE_QUESTIONS"}],
   "expect": {"must_contain": [{"kind": "n8n_node", "canonical_name": "@n8n/n8n-nodes-langchain.agent", "taught_version": "2.2"}]}},

  {"name": "model ids are captured but doc-URL fragments are not",
