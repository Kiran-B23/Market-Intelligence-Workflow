[
 {
  "name": "a bolded-<td> header row still role-types (Google publishes no <th>)",
  "html": "<table><tr><td><b>Model</b></td><td><b>Release date</b></td><td><b>Shutdown date</b></td><td><b>Recommended replacement</b></td></tr><tr><td>gemini-3.1-flash-lite</td><td>May 7, 2026</td><td>May 7, 2027</td><td>gemini-3.5-flash-lite</td></tr></table>",
  "expect": {
   "entries": {
    "gemini-3.1-flash-lite": {
     "retired": true,
     "shutdown_date": "May 7, 2027",
     "replacement_ids": [
      "gemini-3.5-flash-lite"
     ]
    }
   }
  }
 },
 {
  "name": "the shutdown column wins the date role over the release column",
  "html": "<table><tr><td><b>Model</b></td><td><b>Release date</b></td><td><b>Shutdown date</b></td><td><b>Recommended replacement</b></td></tr><tr><td>acme-model-2</td><td>January 1, 2020</td><td>January 1, 2030</td><td></td></tr></table>",
  "expect": {
   "entries": {
    "acme-model-2": {
     "shutdown_date": "January 1, 2030"
    }
   }
  }
 },
 {
  "name": "a <th> header still works (Groq publishes them)",
  "html": "<table><tr><th><b>Deprecated Model</b></th><th><b>Shutdown Date</b></th><th><b>Recommended Replacement Model ID</b></th></tr><tr><td>llama-3.3-70b-versatile</td><td>08/16/26</td><td>llama-4-scout</td></tr></table>",
  "expect": {
   "entries": {
    "llama-3.3-70b-versatile": {
     "retired": true,
     "shutdown_date": "08/16/26"
    }
   }
  }
 },
 {
  "name": "a status parenthetical on the display name retires the coded id in the same row",
  "html": "<table><tr><th>Model</th><th>Description</th><th>Endpoint</th></tr><tr><td>Gemini 2.0 Flash (Shut down)</td><td>workhorse model</td><td><code>gemini-2.0-flash</code></td></tr></table>",
  "expect": {
   "entries": {
    "gemini-2.0-flash": {
     "retired": true
    }
   }
  }
 },
 {
  "name": "MUST NOT retire a live model listed on a deprecations page",
  "html": "<table><tr><td><b>Model</b></td><td><b>Release date</b></td><td><b>Shutdown date</b></td><td><b>Recommended replacement</b></td></tr><tr><td>gemini-2.5-flash</td><td>May 19, 2026</td><td>No shutdown date announced</td><td></td></tr><tr><td>gemini-2.5-flash-image</td><td>October 2, 2025</td><td>October 2, 2026</td><td>gemini-3.1-flash-image</td></tr></table>",
  "expect": {
   "entries": {
    "gemini-2.5-flash": {
     "retired": false,
     "status": "available"
    },
    "gemini-2.5-flash-image": {
     "retired": true
    }
   }
  }
 },
 {
  "name": "MUST NOT treat a declared-deprecated table as dateless-safe",
  "html": "<table><tr><th><b>Deprecated Model</b></th><th><b>Shutdown Date</b></th><th><b>Recommended Replacement Model ID</b></th></tr><tr><td>qwen/qwen3-32b</td><td></td><td></td></tr></table>",
  "expect": {
   "entries": {
    "qwen/qwen3-32b": {
     "retired": true
    }
   }
  }
 },
 {
  "name": "MUST NOT promote a data row whose first cell reads like a header",
  "html": "<table><tr><td>Model</td><td>gemini-2.0-flash</td></tr><tr><td>Endpoint</td><td>gemini-2.5-flash</td></tr></table>",
  "expect": {
   "no_entries": true
  }
 },
 {
  "name": "MUST NOT mistake a replacement-column id for a retired one",
  "html": "<table><tr><th><b>Deprecated Model</b></th><th><b>Shutdown Date</b></th><th><b>Recommended Replacement Model ID</b></th></tr><tr><td>old-model-1</td><td>01/01/26</td><td>shiny-model-9</td></tr></table>",
  "expect": {
   "entries": {
    "old-model-1": {
     "retired": true
    }
   },
   "not_id_column": [
    "shiny-model-9"
   ]
  }
 },
 {
  "name": "MUST NOT role-type a table with no identifier column",
  "html": "<table><tr><th><b>Tier</b></th><th><b>Price</b></th></tr><tr><td>Fast</td><td>$1 / MTok</td></tr><tr><td>Slow</td><td>$0.10 / MTok</td></tr></table>",
  "expect": {
   "no_entries": true
  }
 },
 {
  "name": "MUST NOT match a suffixed sibling on a substring",
  "html": "<table><tr><th><b>Model</b></th><th><b>Endpoint</b></th></tr><tr><td>gemini-3.1-flash-lite (Shut down)</td><td>gemini-3.1-flash-lite</td></tr></table>",
  "expect": {
   "entries": {
    "gemini-3.1-flash-lite": {
     "retired": true
    }
   },
   "absent": [
    "gemini-3.1-flash",
    "gemini-3.1-flash-lite-preview"
   ]
  }
 }
]