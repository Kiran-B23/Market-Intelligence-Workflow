# MIW configuration. Every key here is OPTIONAL.
#
# The ground-truth path is deterministic and needs no credentials: authoritative
# claims come from fetching each tool's own pages (changelog, pricing, deprecation,
# status) and quoting them verbatim. Run `python3 main.py run-weekly` with this file
# absent and you still get cited, authoritative findings.
#
# NOTE: the optional packages are NOT installed by `pip install -r requirements.txt`.
# Setting a key here does nothing until you also run:
#     pip install -r requirements-optional.txt
#
# What the keys add:
#   TAVILY_API_KEY       discovery of replacement tools we have never heard of, and
#                        indexed lookup *within* a vendor's own domains. Without it,
#                        only vendor-named successors are surfaced.
#   ANTHROPIC_API_KEY    LLM refinement of recommendation prose via the Messages API.
#   OPENROUTER_API_KEY   the same, via OpenRouter, as an alternative.
#                        Either way the LLM is never a source of facts: it may only
#                        reword what the deterministic pipeline already established,
#                        and a rewrite naming a URL that is not already in the
#                        evidence is rejected whole.
#   GITHUB_TOKEN         raises the GitHub API rate limit for repo archived/staleness
#                        checks. Unauthenticated works but throttles at ~60 req/hour.

# TAVILY_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=

# --- which backend refines notes -------------------------------------------
# `auto` (the default) prefers the Claude Code CLI whenever `claude` is on PATH, then
# ANTHROPIC_API_KEY, then OPENROUTER_API_KEY. The CLI comes first deliberately: it
# draws on a Claude Code entitlement rather than metered spend, so a key exported for
# some unrelated tool never silently starts charging. To spend, ask for it explicitly.
# MIW_LLM_PROVIDER=auto        # auto | claude_code | anthropic | openrouter | none

# A LOGICAL model name — haiku | sonnet | opus — resolved per provider. Any other
# value is passed through verbatim, so an exact snapshot id can be pinned.
# MIW_LLM_MODEL=haiku

# Daily caps, shared across every stage (each stage is a subprocess, so these live in
# state/llm_budget.json rather than in memory).
# LLM_MAX_CALLS=120
# LLM_MAX_SPEND_USD=2.00

# OpenRouter-specific override, used only when that provider is selected.
LLM_MODEL=anthropic/claude-haiku-4-5
LLM_BASE_URL=https://openrouter.ai/api/v1

# Research budget per weekly run.
RESEARCH_MAX_DEPS=40
ROTATION_SLICE=12
